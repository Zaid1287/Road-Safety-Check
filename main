#include <stdio.h>
#include <stdlib.h>

#define MAX 100

typedef struct {
    int* adj[MAX];
    int size[MAX];
    int visited[MAX];
    int vertices;
} Graph;

void initGraph(Graph* g, int v) {
    g->vertices = v;
    for (int i = 0; i < v; i++) {
        g->adj[i] = malloc(MAX * sizeof(int));
        g->size[i] = 0;
        g->visited[i] = 0;
    }
}

void addEdge(Graph* g, int u, int v) {
    g->adj[u][g->size[u]++] = v;
    g->adj[v][g->size[v]++] = u;
}

int hasCycleDFS(Graph* g, int curr, int parent) {
    g->visited[curr] = 1;
    for (int i = 0; i < g->size[curr]; i++) {
        int neighbor = g->adj[curr][i];
        if (!g->visited[neighbor]) {
            if (hasCycleDFS(g, neighbor, curr)) return 1;
        } else if (neighbor != parent) {
            return 1;
        }
    }
    return 0;
}

void printGraph(Graph* g) {
    printf("Graph (Adjacency List):\n");
    for (int i = 0; i < g->vertices; i++) {
        printf("%d: ", i);
        for (int j = 0; j < g->size[i]; j++) {
            printf("%d ", g->adj[i][j]);
        }
        printf("\n");
    }
}

int main(void) {
    int v, e;
    Graph g;

    printf("Enter number of junctions: ");
    scanf("%d", &v);
    printf("Enter number of roads: ");
    scanf("%d", &e);

    initGraph(&g, v);

    printf("Enter roads (pairs of junction IDs, 0-based):\n");
    for (int i = 0; i < e; i++) {
        int a, b;
        scanf("%d %d", &a, &b);
        addEdge(&g, a, b);
    }

    printGraph(&g);

    int cycleFound = 0;
    for (int i = 0; i < v; i++) {
        if (!g.visited[i]) {
            if (hasCycleDFS(&g, i, -1)) {
                cycleFound = 1;
                break;
            }
        }
    }

    if (cycleFound)
        printf("Result: Cycle detected in the road network.\n");
    else
        printf("Result: No cycle in the road network.\n");

    for (int i = 0; i < v; i++) free(g.adj[i]);

    return 0;
}
